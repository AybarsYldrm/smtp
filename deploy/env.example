# Fitfak posta sunucusu — ortam değişkenleri
#
#   cp deploy/env.example /etc/fitfak/mail.env
#   chmod 600 /etc/fitfak/mail.env
#
# Bu dosya SIRLARI TAŞIR. Depoya işlenmez, yedeği veritabanı yedeğiyle aynı
# yerde durmaz: kasa sırrı ile şifreli veriyi aynı kutuya koymak iki katmanı
# tek katmana indirir.

NODE_ENV=production

# ── zorunlu sırlar ────────────────────────────────────────────────────────
# Üretimde eksikse sunucu açılışta hata verir; sessizce öntanımlıya düşmez.
#   openssl rand -base64 48
FITFAK_MAIL_VAULT_SECRET=
FITFAK_MAIL_DB_ROOT_SECRET=

# Fitfak IdP istemci bilgileri (session.fitfak.net üzerinde tanımlı).
FITFAK_MAIL_CLIENT_ID=
FITFAK_MAIL_CLIENT_SECRET=
# Cihaz kodu akışı genel istemcidir: sırrı yoktur, ayrı bir kimlik alır.
FITFAK_MAIL_DEVICE_CLIENT_ID=

# Giden postanın çıktığı genel IP. SPF kaydı ve PTR bunun üzerine kurulu;
# yanlış değer "postam neden spam'e düşüyor" sorusunun en sık cevabı.
FITFAK_MAIL_PUBLIC_IP=

# ── alan adları ───────────────────────────────────────────────────────────
FITFAK_MAIL_DOMAIN=fitfak.net
FITFAK_MAIL_HOSTNAME=mail.fitfak.net
FITFAK_MAIL_DKIM_SELECTOR=mail
FITFAK_SITE_DOMAIN=aybars.net.tr

# ── vhost'lar (cloudflared çıkışları) ─────────────────────────────────────
# Her isim kendi loopback adresine bağlanır; yanlış yapılandırılmış bir tünel
# diğerinin soketine bağlanamaz bile.
FITFAK_SITE_HOST=aybars.net.tr
FITFAK_SITE_BIND=127.0.1.1
FITFAK_SITE_PORT=80
FITFAK_SITE_ALIASES=www.aybars.net.tr

FITFAK_WEBMAIL_HOST=mail.fitfak.net
FITFAK_WEBMAIL_BIND=127.0.1.2
FITFAK_WEBMAIL_PORT=80
FITFAK_WEBMAIL_ALIASES=webmail.fitfak.net

# ── dizinler ──────────────────────────────────────────────────────────────
FITFAK_MAIL_DATA_DIR=/var/lib/fitfak-mail/data
FITFAK_MAIL_CERT_DIR=/var/lib/fitfak-mail/certs
# FITFAK_MAIL_PUBLIC_DIR=/opt/fitfak-mail/public

# ── veritabanı ────────────────────────────────────────────────────────────
# auto   : @fitfak/database varsa onu, yoksa şifreli dosya sürücüsünü kullan
# fitfak : gömülü ya da uzak (FITFAK_MAIL_DB_TARGET verilirse uzak)
# file   : şifreli dosya sürücüsü (tek süreç varsayar)
FITFAK_MAIL_DB_DRIVER=auto

# Uzak (mTLS / gRPC) kullanılıyorsa:
# FITFAK_MAIL_DB_TARGET=db.fitfak.net:8443
# FITFAK_MAIL_DB_SERVICE_NAME=mail-service
# FITFAK_MAIL_DB_OWNER_ID=mail-service
# FITFAK_MAIL_DB_CA_PATH=/etc/fitfak/db-ca.pem
# FITFAK_MAIL_DB_IDENTITY_DIR=/var/lib/fitfak-mail/identity
# Kayıt sırrı YALNIZCA ilk açılışta gerekir; kimlik yazıldıktan sonra silin.
# FITFAK_MAIL_DB_ENROLMENT_SECRET=

# ── IdP ───────────────────────────────────────────────────────────────────
FITFAK_IDP_BASE_URL=https://session.fitfak.net
# `email` kapsamı olmadan kutu yetkilendirmesi yapılamaz. `cert:issue`
# sertifika istemek için gerekiyor; oturumda yoksa kullanıcı tek seferlik bir
# onay turuna yönlendirilir.
FITFAK_MAIL_SCOPES=openid,profile,email,cert:issue
# Harici adresleri kutulara bağlayabilecek roller.
FITFAK_IDP_ADMIN_ROLES=admin,fitfak-admin
# FITFAK_IDP_ADMIN_SUBJECTS=
# fitfak-idp'nin kendi yönetici kuralı TEK bir doğrulanmış adrese dayanıyor;
# aynı adresi burada da tanıtın, yoksa IdP'de yönetici olan kişi posta
# tarafında yönetici olmaz.
# FITFAK_IDP_ADMIN_EMAILS=yonetici@fitfak.net
# Kendi alan adımızdaki DOĞRULANMIŞ bir kimlik ilk girişte kutusunu alır.
# Harici adresler (gmail.com vb.) buna dâhil DEĞİLDİR; onlar için yöneticinin
# kurduğu bir kimlik bağı gerekir.
FITFAK_MAIL_AUTO_PROVISION=1
FITFAK_MAIL_SESSION_TTL_MS=43200000
FITFAK_MAIL_REVALIDATE_MS=300000

# ── sertifika sağlayıcısı ─────────────────────────────────────────────────
FITFAK_TRUST_BASE_URL=https://trust.fitfak.net
FITFAK_TRUST_SMIME_PROFILE=smime
FITFAK_TRUST_AUTO_ISSUE=1
FITFAK_TRUST_CHECK_MS=21600000
# Sertifika istemek için gereken kapsam.
FITFAK_TRUST_ISSUE_SCOPE=cert:issue
# Servis (client_credentials) kimliğiyle sertifika istemeye izin.
# KULLANICI kutuları için işe yaramaz: o jetonun öznesi bir kullanıcı değil,
# uygulamanın kendisidir ve IdP isteği "Kullanıcı bulunamadı" ile reddeder.
# Yalnızca sistem kutuları (postmaster, dmarc) için anlamlı.
FITFAK_TRUST_ALLOW_SERVICE_IDENTITY=0
# trust.fitfak.net'in önündeki zincir özel bir kökten geliyorsa:
# FITFAK_TRUST_CA_PATH=/etc/fitfak/trust-root.crt

# ── SMTP ──────────────────────────────────────────────────────────────────
FITFAK_SMTP_BIND=0.0.0.0
FITFAK_SMTP_PORT_MX=25
FITFAK_SMTP_PORT_SUBMISSION=587
FITFAK_SMTP_PORT_SMTPS=465
# Birden fazla IP varsa PTR kaydı olan adresten çıkın; alıcı aksini reddeder.
# FITFAK_SMTP_OUTBOUND_IP=
FITFAK_SMTP_MAX_MESSAGE_BYTES=41943040
FITFAK_SMTP_MAX_RCPT=100
FITFAK_SMTP_REQUIRE_TLS_FOR_AUTH=1
FITFAK_SMTP_INBOUND_CHECKS=1
FITFAK_SMTP_ENFORCE_DMARC=1
# PROXY protokolü yalnızca buradan kabul edilir: aksi hâlde herhangi bir
# istemci sahte kaynak IP bildirip IP tabanlı kısıtlamaları atlar.
FITFAK_SMTP_TRUSTED_PROXIES=127.0.0.1,::1

# ── sınırlar ──────────────────────────────────────────────────────────────
FITFAK_MAILBOX_QUOTA_BYTES=5368709120
FITFAK_MAX_ATTACHMENTS=25
FITFAK_MAX_ATTACHMENT_BYTES=26214400
FITFAK_MAX_TOTAL_ATTACHMENT_BYTES=36700160
FITFAK_MAX_INLINE_IMAGE_BYTES=8388608

# ── kuyruk / toplu gönderim ───────────────────────────────────────────────
FITFAK_QUEUE_WORKERS=4
# Alan adı başına eşzamanlılık: 50 paralel bağlantı teslimatı hızlandırmaz,
# hız sınırına ve geçici bloklara sokar.
FITFAK_QUEUE_PER_DOMAIN=2
FITFAK_CAMPAIGN_RATE=10
FITFAK_CAMPAIGN_BATCH=500

# ── HTTP ──────────────────────────────────────────────────────────────────
# TLS'i cloudflared sonlandırır; istemci IP'si başlıktan gelir ve yalnızca
# bu adreslerden gelen başlıklara güvenilir.
FITFAK_HTTP_TRUSTED_PROXIES=127.0.0.1,::1,127.0.1.1,127.0.1.2
FITFAK_SECURE_COOKIES=1
FITFAK_HTTP_RATE_MAX=240
FITFAK_HTTP_RATE_SEND_MAX=30

# ── DNS denetimi ──────────────────────────────────────────────────────────
# Öntanımlı SALT OKUNUR. Açarsanız elle konmuş bilinçli bir kaydı (ikinci MX,
# geçiş dönemi SPF'i) geri alabilir; POST /api/v1/status/dns/apply ile elle
# tetiklemek daha güvenli.
FITFAK_DNS_AUTO_APPLY=0
FITFAK_DMARC_POLICY=quarantine
# CF_API_TOKEN=
# CF_ZONE_ID=

# ── kişisel site ──────────────────────────────────────────────────────────
FITFAK_SITE_TRACK_INSTAGRAM=1
FITFAK_SITE_NOTIFY_MAILBOX=network@fitfak.net

# ── kayıt ─────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error | silent
# `trace` protokol seviyesini açar (SMTP komutları, IdP ve sertifika sunucusu
# istek/yanıtları, DKIM imza girdisi). Sırlar her seviyede maskelenir ama
# trace yine de ileti üstverisi yazar; üretimde geçici olarak açın.
LOG_LEVEL=info
LOG_JSON=1
# LOG_COLOR=0
# Kayıt dosyası, veritabanının şifrelediği veriyi düz metin sızdıran yer
# olmamalı. Hata ayıklarken geçici olarak 0 yapın.
LOG_REDACT_ADDRESSES=1
